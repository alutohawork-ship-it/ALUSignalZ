+    zone: { id: order.zoneId, timeframe: 'M5', type: `FVG ${side === 'sell' ? 'bearish' : 'bullish'} retest`, top: f.top, bottom: f.bottom, fresh: true },
+    regime: side === 'sell' ? 'trending_down' : 'trending_up',
+    regimeSrc: 'H1 MS · KONTINUITAS',
+    checks,
+  };
+}
